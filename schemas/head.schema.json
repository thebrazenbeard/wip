{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thebrazenbeard/wip/schemas/head.schema.json",
  "title": "WIP HEAD Projection V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "generation",
    "lifecycle",
    "latest_checkpoint",
    "latest_operation_event",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "workspace_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "generation": {"type": "integer", "minimum": 0},
    "lifecycle": {
      "enum": ["ACTIVE", "PAUSED", "PROMOTED", "SHELVED", "SUPERSEDED", "ABANDONED"]
    },
    "latest_checkpoint": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^cp-[0-9]{6}$"}
      ]
    },
    "latest_operation_event": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^op-[0-9]{6}-[0-9]{2}-[a-z]+$"}
      ]
    },
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
