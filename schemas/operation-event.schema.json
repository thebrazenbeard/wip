{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thebrazenbeard/wip/schemas/operation-event.schema.json",
  "title": "WIP Operation Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "operation_id",
    "sequence",
    "state",
    "created_at",
    "writer",
    "action_class",
    "target",
    "intent_summary",
    "recovery_instruction",
    "previous_event"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "workspace_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "operation_id": {"type": "string", "pattern": "^op-[0-9]{6}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 99},
    "state": {"enum": ["PREPARED", "ATTEMPTED", "VERIFIED", "FAILED", "AMBIGUOUS", "ABSENT", "RECONCILED", "CONFLICT"]},
    "created_at": {"type": "string", "format": "date-time"},
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "route"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "route": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "action_class": {"type": "string", "minLength": 1, "maxLength": 120},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 80},
        "locator": {"type": "string", "minLength": 1, "maxLength": 500},
        "expected_precondition": {"type": "string", "maxLength": 1000}
      }
    },
    "intent_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "recovery_instruction": {"enum": ["inspect_before_retry", "no_retry_required"]},
    "previous_event": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^op-[0-9]{6}-[0-9]{2}-[a-z]+$"}
      ]
    },
    "result_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "effect_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 80},
        "value": {"type": "string", "minLength": 1, "maxLength": 1000},
        "readback": {"type": "string", "maxLength": 1000}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["VERIFIED", "RECONCILED"]}}},
      "then": {"required": ["effect_receipt", "result_summary"]}
    },
    {
      "if": {"properties": {"state": {"enum": ["ABSENT", "CONFLICT"]}}},
      "then": {"required": ["result_summary"]}
    },
    {
      "if": {"properties": {"state": {"const": "PREPARED"}}},
      "then": {"properties": {"previous_event": {"type": "null"}}}
    }
  ]
}
